# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# API-Football key from https://dashboard.api-football.com
API_FOOTBALL_KEY=your_api_football_key_here

# Public HTTPS URL where THIS app is deployed (Render/Railway/Fly/VPS + domain).
# Must be https:// and reachable from the internet — Telegram opens the Mini App at this URL.
WEBAPP_URL=https://your-deployed-app.example.com

# Port the Express server listens on (most hosts inject this automatically)
PORT=3000
